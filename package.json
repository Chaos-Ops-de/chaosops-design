{
  "name": "@chaos-ops-de/design",
  "version": "0.10.0",
  "description": "Shared design system for ChaosOps — tokens, theme, cross-platform primitives (React Native + react-native-web), icons, and mascot assets.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chaos-Ops-de/chaosops-design.git"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js",
      "require": "./dist/tokens/index.cjs"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "react-native": "./dist/icons/native.js",
      "import": "./dist/icons/web.js",
      "require": "./dist/icons/web.cjs"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js",
      "require": "./dist/web/index.cjs"
    },
    "./web.css": "./dist/web/index.css",
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "import": "./dist/primitives/index.js",
      "require": "./dist/primitives/index.cjs"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js",
      "require": "./dist/contracts/index.cjs"
    },
    "./assets/*": "./src/assets/*"
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "motion": "^13.0.0"
  },
  "peerDependencies": {
    "@sentry/react": "*",
    "lucide-react": "*",
    "lucide-react-native": "*",
    "react": ">=18",
    "react-dom": ">=18",
    "react-native": "*",
    "react-native-safe-area-context": "*",
    "react-native-web": "*",
    "react-router-dom": "*"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    },
    "react-native-web": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "lucide-react-native": {
      "optional": true
    },
    "@sentry/react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sentry/react": "^10.69.0",
    "@storybook/addon-a11y": "^10.5.6",
    "@storybook/addon-docs": "^10.5.6",
    "@storybook/react-vite": "^10.5.6",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.4",
    "@types/react-native": "^0.72.8",
    "@vitejs/plugin-react": "^5.2.0",
    "lucide-react": "^0.555.0",
    "lucide-react-native": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.8",
    "react-native": "^0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "react-router-dom": "^7.18.2",
    "storybook": "^10.5.6",
    "tsup": "^8.3.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
